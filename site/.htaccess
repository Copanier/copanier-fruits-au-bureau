# Fichier utilisé par les hébergeurs Apache (OVH, o2switch, Ionos…). Ignoré ailleurs.
ErrorDocument 404 /404.html
RewriteEngine On

# Forcer HTTPS et l'adresse avec « www » (celle que Google connaît depuis des années)
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} !^www\. [NC]
RewriteRule ^ https://www.copanier.fr%{REQUEST_URI} [L,R=301]

# ===== Anciennes pages du site Wix → nouvelles pages (301 = définitif) =====
RewriteRule ^feed/rss2/?$ / [R=301,L,NC]
RewriteRule ^feed/atom/?$ / [R=301,L,NC]
